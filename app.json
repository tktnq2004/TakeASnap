{
  "expo": {
    "name": "TakeASnap",
    "slug": "takeasnap",
    "scheme": "takeasnap",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "dark",
    "backgroundColor": "#18191b",
    "ios": {
      "supportsTablet": false,
      "infoPlist": {
        "NSCameraUsageDescription": "TakeASnap cần camera để chụp theo pose.",
        "NSPhotoLibraryUsageDescription": "TakeASnap cần đọc ảnh để lấy dáng từ ảnh của bạn.",
        "NSPhotoLibraryAddUsageDescription": "TakeASnap cần quyền lưu ảnh vào album TakeASnap."
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#18191b",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "plugins": ["expo-router", "expo-sqlite", "expo-font", "expo-asset"],
    "experiments": {
      "typedRoutes": true
    }
  }
}
