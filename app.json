{
  "expo": {
    "name": "SnapShot",
    "slug": "snapshot",
    "scheme": "snapshot",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "backgroundColor": "#05070D",
    "ios": {
      "supportsTablet": false,
      "infoPlist": {
        "NSCameraUsageDescription": "SnapShot cần camera để chụp theo pose.",
        "NSPhotoLibraryUsageDescription": "SnapShot cần đọc ảnh để lấy dáng từ ảnh của bạn.",
        "NSPhotoLibraryAddUsageDescription": "SnapShot cần quyền lưu ảnh vào album SnapShot."
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#05070D",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "plugins": ["expo-router", "expo-sqlite", "expo-font", "expo-asset"],
    "experiments": {
      "typedRoutes": true
    }
  }
}
