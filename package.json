{
  "name": "takeasnap",
  "version": "1.0.0",
  "main": "expo-router/entry",
  "private": true,
  "jest": {
    "preset": "jest-expo",
    "testPathIgnorePatterns": [
      "/node_modules/",
      "/.expo/"
    ],
    "moduleNameMapper": {
      "^@/(.*)$": "<rootDir>/src/$1"
    }
  },
  "scripts": {
    "start": "expo start",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "lint": "expo lint",
    "typecheck": "tsc --noEmit && tsc -p scripts --noEmit",
    "test": "jest",
    "format": "prettier --write .",
    "check": "npm run typecheck && npm run lint && npm run test",
    "build:samples": "node scripts/build-sample-poses.mts"
  },
  "dependencies": {
    "@expo-google-fonts/dm-mono": "^0.4.2",
    "@expo-google-fonts/urbanist": "^0.4.2",
    "@shopify/react-native-skia": "2.14.0",
    "expo": "~58.0.23",
    "expo-asset": "~58.0.20",
    "expo-camera": "~58.0.14",
    "expo-constants": "~58.0.15",
    "expo-file-system": "~58.0.13",
    "expo-font": "~58.0.11",
    "expo-haptics": "~58.0.7",
    "expo-image-manipulator": "~58.0.16",
    "expo-image-picker": "~58.0.10",
    "expo-linking": "~58.0.16",
    "expo-media-library": "~58.0.13",
    "expo-router": "~58.0.30",
    "expo-sensors": "~58.0.4",
    "expo-sqlite": "~58.0.15",
    "expo-status-bar": "~58.0.4",
    "lucide-react-native": "^1.70.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-native": "0.88.1",
    "react-native-gesture-handler": "~3.3.0",
    "react-native-reanimated": "4.7.1",
    "react-native-safe-area-context": "~5.11.1",
    "react-native-screens": "~4.30.1",
    "react-native-svg": "15.16.0",
    "react-native-webview": "14.0.1",
    "react-native-worklets": "0.13.0",
    "zustand": "^5.1.0"
  },
  "devDependencies": {
    "@types/jest": "^30.0.0",
    "@types/react": "~19.3.0",
    "eslint": "^9.39.5",
    "eslint-config-expo": "^58.0.4",
    "eslint-config-prettier": "^10.1.8",
    "jest": "^30.5.2",
    "jest-expo": "^58.0.14",
    "prettier": "^3.9.10",
    "puppeteer-core": "^25.16.0",
    "typescript": "~6.0.3"
  }
}
